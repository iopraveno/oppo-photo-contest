# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the website (no trailing slash). Optional on Vercel: defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.opposoutez.cz

# Instagram handle of OPPO CZ, without @
NEXT_PUBLIC_IG_HANDLE=oppo_cesko

# Comma-separated e-mails that can open /admin
ADMIN_EMAILS=jmeno@firma.cz,kolega@firma.cz

# Random long string used to hash IP addresses of voters
VOTE_SALT=change-me-to-a-long-random-string

# Max votes from one IP address per hour
VOTES_PER_IP_PER_HOUR=40

# Optional: Cloudflare Turnstile captcha on sign-in (leave empty to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Photo walk e-mails over SMTP (same mailbox Supabase uses for sign-in codes)
SMTP_HOST=smtp.forpsi.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OPPO Česko <ahoj@opposoutez.cz>
# Optional
MAIL_REPLY_TO=
PHOTOWALK_NOTIFY_EMAILS=
# Optional: e-mails that may open only /admin/photowalk (ADMIN_EMAILS can open it too)
PHOTOWALK_ADMIN_EMAILS=
